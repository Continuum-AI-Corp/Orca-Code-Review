# Install demo: the guided flow in a fresh repo, every answer the recommended one.
Output docs/demo-install.gif
Output docs/demo-install.mp4
Set Shell "bash"
Set FontSize 15
Set Width 1180
Set Height 700
Set TypingSpeed 50ms
Hide
Type "cd /tmp/orcacode-demo && export PS1='$ ' && clear" Enter
Show
Type "npx @orcarouter/code-review" Sleep 500ms Enter
Sleep 5s
Enter
Sleep 2500ms
Enter
Sleep 2500ms
Enter
Sleep 2500ms
Enter
Sleep 9s
